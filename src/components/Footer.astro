---
import { Monogram } from "@/components/Brand";
import { SALON_INFO } from "@/data/salon";

const footerCols = [
  {
    title: "Servicios",
    links: [
      { label: "Tratamiento Alisador (Keratina)", href: "#servicios" },
      { label: "Botox Capilar Suntuoso", href: "#servicios" },
      { label: "Tinte & Mechas de Autor", href: "#servicios" },
      { label: "Lavado, Cepillado & Planchado", href: "#servicios" },
      { label: "Corte Dama & Caballero", href: "#servicios" },
      { label: "Limpieza Facial & Cejas", href: "#servicios" },
    ],
  },
  {
    title: "Productos",
    links: [
      { label: "Shampoo Herbal Extractos Naturales", href: "#productos" },
      { label: "Shampoo Anticaspa Mentol & Argán", href: "#productos" },
      { label: "Tratamiento Acondicionador Anti Frizz", href: "#productos" },
      { label: "Shampoo Libre de Sal", href: "#productos" },
      { label: "Kit Dúo de Cuidado", href: "#productos" },
      { label: "Kit de Alisado Térmico", href: "#productos" },
    ],
  },
  {
    title: "Casa Suntuosa",
    links: [
      { label: "Servicios de Autor", href: "#servicios" },
      // { label: "Planes & Membresías", href: "#planes" },
      // { label: "Preguntas Frecuentes", href: "#faq" },
      { label: "Agendar Cita Previa", href: "#contacto" },
    ],
  },
];
---

<footer class="relative overflow-hidden border-t border-ink-900/8 bg-cream-100 pt-16">
  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
    <div class="grid gap-10 lg:grid-cols-[1.4fr_repeat(3,0.8fr)]">
      <div>
        <a href="#top" class="flex items-center gap-3">
          <Monogram className="h-11 w-11" />
          <span class="flex flex-col leading-none">
            <span class="font-display text-xl font-semibold tracking-tight text-ink-950">
              {SALON_INFO.name}
            </span>
            <span class="mt-1 text-[0.58rem] font-medium uppercase tracking-[0.3em] text-gold-600">
              {SALON_INFO.tagline}
            </span>
          </span>
        </a>
        <p class="mt-5 max-w-sm text-[0.88rem] leading-relaxed text-ink-700">
          Un espacio donde la técnica profesional, la calidez humana y la ciencia capilar se encuentran para brindarte un cabello extraordinario todos los días.
        </p>

        <address class="mt-6 space-y-2.5 not-italic text-[0.85rem] text-ink-700">
          <p class="flex items-start gap-2">
            <span class="text-gold-600">◆</span> {SALON_INFO.address}, {SALON_INFO.city}
          </p>
          <p class="flex items-center gap-2">
            <span class="text-gold-600">◆</span>
            <a href={`tel:${SALON_INFO.whatsappNumber}`} class="transition-colors hover:text-ink-950 font-medium">
              {SALON_INFO.phone}
            </a>
          </p>
          <p class="flex items-center gap-2">
            <span class="text-gold-600">◆</span>
            <a href={`mailto:${SALON_INFO.email}`} class="transition-colors hover:text-ink-950">
              {SALON_INFO.email}
            </a>
          </p>
          <p class="flex items-center gap-2">
            <span class="text-gold-600">◆</span> {SALON_INFO.schedule}
          </p>
          <p class="flex items-center gap-2">
            <span class="text-gold-600">◆</span> Domicilios en Montería: {SALON_INFO.domicilioPrice}
          </p>
        </address>

        <div class="mt-6 flex gap-2.5">
          {[
            { label: "Instagram", href: SALON_INFO.instagram, d: "M12 7.4a4.6 4.6 0 100 9.2 4.6 4.6 0 000-9.2zm0 7.6a3 3 0 110-6 3 3 0 010 6zm5.9-7.8a1.07 1.07 0 11-2.15 0 1.07 1.07 0 012.15 0zM21 8.1c-.05-1.4-.37-2.65-1.4-3.67-1.02-1.02-2.26-1.34-3.67-1.42-1.45-.08-5.8-.08-7.25 0-1.4.07-2.64.39-3.67 1.41S3.67 6.68 3.6 8.09c-.08 1.45-.08 5.8 0 7.25.05 1.41.37 2.65 1.4 3.67s2.26 1.34 3.67 1.42c1.45.08 5.8.08 7.25 0 1.41-.06 2.65-.38 3.67-1.42 1.02-1.02 1.34-2.26 1.42-3.67.08-1.45.08-5.79 0-7.24zm-1.9 8.8a3.04 3.04 0 01-1.71 1.71c-1.18.47-3.99.36-5.3.36s-4.12.1-5.3-.36a3.04 3.04 0 01-1.71-1.71c-.47-1.18-.36-3.99-.36-5.3s-.1-4.12.36-5.3a3.04 3.04 0 011.71-1.71c1.18-.47 3.99-.36 5.3-.36s4.12-.1 5.3.36a3.04 3.04 0 011.71 1.71c.47 1.18.36 3.99.36 5.3s.11 4.12-.36 5.3z" },
            { label: "Facebook", href: SALON_INFO.facebook, d: "M14 8.5h2.2V5.6c-.4-.05-1.6-.17-3-.17-3 0-5 1.8-5 5.2v2.6H5.7v3.2h2.5V24h3.2v-7.6h2.5l.4-3.2h-2.9v-2.3c0-.9.3-1.4 1.6-1.4z" },
          ].map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.label}
              class="grid h-10 w-10 place-items-center rounded-full border border-ink-900/10 bg-white text-ink-800 transition-all duration-300 hover:-translate-y-1 hover:border-gold-400 hover:text-gold-600 shadow-sm"
            >
              <svg viewBox="0 0 24 24" class="h-4.5 w-4.5 fill-current" aria-hidden="true">
                <path d={s.d}></path>
              </svg>
            </a>
          ))}
        </div>
      </div>

      {footerCols.map((col) => (
        <div>
          <h3 class="text-[0.7rem] font-semibold uppercase tracking-[0.2em] text-ink-950">
            {col.title}
          </h3>
          <ul class="mt-4 space-y-2.5">
            {col.links.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="group inline-flex items-center gap-1.5 text-[0.85rem] text-ink-700 transition-colors duration-300 hover:text-ink-950"
                >
                  <span class="h-px w-0 bg-gold-500 transition-all duration-300 group-hover:w-3"></span>
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-14 flex flex-col items-center justify-between gap-4 border-t border-ink-900/8 py-7 text-[0.75rem] text-ink-600 sm:flex-row">
      <p>© {new Date().getFullYear()} Casa Suntuosa. Montería, Córdoba. Todos los derechos reservados.</p>
      <div class="flex gap-6">
        <a href="#top" class="transition-colors hover:text-ink-950">
          Política de Tratamiento de Datos
        </a>
        <a href="#top" class="transition-colors hover:text-ink-950">
          Términos del Servicio
        </a>
      </div>
    </div>
  </div>

  <p
    aria-hidden="true"
    class="pointer-events-none select-none bg-gradient-to-b from-ink-900/8 to-transparent bg-clip-text text-center font-display text-[17vw] font-light leading-[0.8] tracking-tighter text-transparent"
  >
    Suntuosa
  </p>
</footer>
