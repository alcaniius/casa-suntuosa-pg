---
import { Counter } from "@/lib/motion";
import { SectionLabel, Stars } from "@/components/Brand";
import { IMG, WHATSAPP } from "@/data/salon";
---

<section id="top" class="relative overflow-hidden pb-20 pt-28 sm:pt-32 lg:pb-32 lg:pt-40">
  {/* Ambient atmospheric lighting - directional linear gradient fading to the right */}
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute inset-0 bg-cream-50"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-cream-200/90 via-cream-100/50 to-transparent"></div>
    <div class="absolute inset-y-0 left-0 w-full lg:w-4/5 bg-[linear-gradient(90deg,rgba(211,169,95,0.22)_0%,rgba(232,184,191,0.14)_35%,rgba(253,249,243,0.05)_75%,transparent_100%)]"></div>
    <div class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-cream-50 to-transparent"></div>
    <div class="noise-overlay absolute inset-0 opacity-[0.14] mix-blend-multiply"></div>
  </div>

  <div class="mx-auto grid w-full max-w-7xl gap-14 px-4 sm:px-6 lg:grid-cols-[1.05fr_1fr] lg:items-center lg:gap-10">
    {/* Editorial Copy */}
    <div class="relative">
      <div>
        <SectionLabel>Salón de Alta Gama · Montería</SectionLabel>
      </div>

      <h1 class="mt-6 font-display text-[2.6rem] font-light leading-[1.04] tracking-[-0.03em] text-ink-950 sm:text-6xl lg:text-[4.35rem]">
        Tu cabello merece
        <br />
        <span class="italic font-medium text-gradient-gold">una casa suntuosa</span>
      </h1>

      <p class="mt-6 max-w-xl text-[1.02rem] leading-relaxed text-ink-700 sm:text-lg">
        Tratamientos capilares de autor, fórmulas anti-humedad y productos profesionales elaborados en nuestro laboratorio para el clima del Sinú. Diagnóstico gratuito y resultados visibles desde la primera sesión.
      </p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href={WHATSAPP}
          target="_blank"
          rel="noreferrer"
          class="group relative inline-flex items-center justify-center gap-2.5 overflow-hidden rounded-full bg-ink-900 px-7 py-4 text-sm font-semibold text-cream-50 shadow-[0_20px_45px_-18px_rgba(27,16,22,0.85)] transition-all duration-400 hover:-translate-y-1 hover:shadow-[0_28px_60px_-20px_rgba(27,16,22,0.9)]"
        >
          <span class="relative z-10">Agenda tu diagnóstico gratis</span>
          <svg
            viewBox="0 0 20 20"
            class="relative z-10 h-4 w-4 transition-transform duration-400 group-hover:translate-x-1"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
          >
            <path d="M4 10h11M11 5.5l4.5 4.5L11 14.5" stroke-linecap="round"></path>
          </svg>
          <span class="absolute inset-0 bg-[linear-gradient(110deg,transparent_25%,rgba(240,220,180,0.45)_50%,transparent_75%)] bg-[length:250%_100%] animate-shimmer"></span>
        </a>

        <a
          href="#productos"
          class="group inline-flex items-center justify-center gap-2 rounded-full border border-ink-900/15 bg-white/60 px-7 py-4 text-sm font-semibold text-ink-900 backdrop-blur transition-all duration-400 hover:border-gold-400 hover:bg-white shadow-sm"
        >
          Ver productos
          <span class="grid h-5 w-5 place-items-center rounded-full bg-gold-300/40 text-[0.6rem] transition-transform duration-400 group-hover:rotate-90">
            ↓
          </span>
        </a>
      </div>

      <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-5">
        <div class="flex items-center gap-3">
          <div class="flex -space-x-3">
            {[
              "https://images.pexels.com/photos/7752815/pexels-photo-7752815.jpeg?auto=compress&cs=tinysrgb&dpr=1&fit=crop&h=120&w=120",
              "https://images.pexels.com/photos/7752818/pexels-photo-7752818.jpeg?auto=compress&cs=tinysrgb&dpr=1&fit=crop&h=120&w=120",
              "https://images.pexels.com/photos/7752791/pexels-photo-7752791.jpeg?auto=compress&cs=tinysrgb&dpr=1&fit=crop&h=120&w=120",
              "https://images.pexels.com/photos/29132010/pexels-photo-29132010.jpeg?auto=compress&cs=tinysrgb&dpr=1&fit=crop&h=120&w=120",
            ].map((src) => (
              <img
                src={src}
                alt="Clienta satisfecha"
                loading="lazy"
                class="h-10 w-10 rounded-full border-2 border-cream-50 object-cover shadow-sm transition-transform duration-300 hover:-translate-y-1"
              />
            ))}
          </div>
          <div class="text-sm">
            <Stars />
            <p class="mt-0.5 text-[0.8rem] text-ink-600">
              <strong class="font-semibold text-ink-900">4.9/5</strong> · +1.200 clientas felices
            </p>
          </div>
        </div>

        <div class="h-10 w-px bg-ink-900/10 max-sm:hidden"></div>

        <div class="text-sm">
          <p class="font-display text-2xl font-semibold text-ink-900">
            <Counter client:load value={12} suffix="+" />
          </p>
          <p class="text-[0.8rem] text-ink-600">años embelleciendo Montería</p>
        </div>
      </div>
    </div>

    {/* Visual Composition */}
    <div class="relative">
      <div class="relative z-10">
        <div class="relative overflow-hidden rounded-[2.2rem] shadow-[0_40px_90px_-40px_rgba(27,16,22,0.7)] ring-1 ring-white/50">
          <img
            src={IMG.heroPortrait}
            alt="Clienta de Casa Suntuosa luciendo ondas brillantes tras un tratamiento capilar"
            class="h-[26rem] w-full object-cover object-center transition-transform duration-[1.6s] ease-out hover:scale-105 sm:h-[32rem] lg:h-[36rem]"
            loading="eager"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-ink-950/60 via-transparent to-transparent"></div>

          <div class="absolute inset-x-4 bottom-4 glass-dark rounded-2xl p-4 text-cream-50 sm:inset-x-5 sm:bottom-5">
            <div class="flex items-center justify-between gap-4">
              <div>
                <p class="text-[0.62rem] font-semibold uppercase tracking-[0.22em] text-gold-200">
                  Tratamiento Destacado
                </p>
                <p class="mt-1 font-display text-lg leading-tight">Alisador Keratina + Botox</p>
              </div>
              <span class="shrink-0 rounded-full bg-gold-300 px-3 py-1.5 text-[0.7rem] font-bold text-ink-950">
                Desde $100.000
              </span>
            </div>
          </div>
        </div>
      </div>

      {/* Floating detail card */}
      <div class="absolute -left-2 top-8 z-20 hidden sm:block lg:-left-12">
        <div class="animate-float glass-light w-56 rounded-2xl p-4 shadow-[0_24px_50px_-24px_rgba(27,16,22,0.55)] border border-white/80">
          <div class="flex items-center gap-3">
            <img
              src="/assets/productos/producto-4.png"
              alt="Shampoo anti frizz"
              class="h-12 w-12 rounded-xl object-contain bg-white/60 p-1"
              loading="lazy"
            />
            <div>
              <p class="text-[0.68rem] font-semibold uppercase tracking-widest text-gold-600">
                Sin Sal ni Sulfatos
              </p>
              <p class="text-[0.78rem] font-bold text-ink-900">Fórmulas Seguras</p>
            </div>
          </div>
          <div class="mt-3 h-1.5 overflow-hidden rounded-full bg-cream-200">
            <div class="h-full w-[95%] rounded-full bg-gradient-to-r from-gold-500 to-gold-300"></div>
          </div>
          <p class="mt-2 text-[0.7rem] text-ink-600">95% menos frizz en clima húmedo</p>
        </div>
      </div>

      {/* Floating stats card */}
      <div class="absolute -bottom-6 -right-1 z-20 hidden md:block lg:-right-6">
        <div class="animate-float-slow glass-light flex items-center gap-3 rounded-2xl px-5 py-4 shadow-[0_24px_50px_-24px_rgba(27,16,22,0.55)] border border-white/80">
          <span class="grid h-10 w-10 place-items-center rounded-full bg-ink-900 text-cream-50">
            <svg
              viewBox="0 0 24 24"
              class="h-5 w-5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              aria-hidden="true"
            >
              <path d="M12 3l2.4 5.2 5.6.7-4.2 3.9 1.1 5.6L12 15.7 7.1 18.4l1.1-5.6L4 8.9l5.6-.7L12 3z"></path>
            </svg>
          </span>
          <div>
            <p class="font-display text-xl leading-none text-ink-950 font-bold">
              <Counter client:load value={4300} suffix="+" />
            </p>
            <p class="text-[0.72rem] text-ink-600">rituales realizados en Montería</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
